# Copie ce fichier en ".env" puis adapte.
PORT=8000
# URL publique (utilisée dans les liens des e-mails). En prod : https://pact.mondomaine.fr
BASE_URL=http://localhost:8000

# --- E-mails (SMTP). Sans SMTP_HOST : mode dev, les liens s'affichent dans la console / data/outbox.log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PACT <no-reply@mondomaine.fr>
SMTP_SECURE=starttls   # starttls (587) ou ssl (465)

# --- Google : ID client OAuth "Application Web" (console.cloud.google.com > Identifiants)
#     Origines JS autorisées : BASE_URL
GOOGLE_CLIENT_ID=

# --- Apple : "Services ID" (developer.apple.com > Sign in with Apple). Nécessite HTTPS + domaine vérifié.
APPLE_CLIENT_ID=
APPLE_REDIRECT_URI=

# Origines autorisées pour l'app native (CORS)
CORS_ORIGINS=capacitor://localhost,http://localhost,https://localhost

